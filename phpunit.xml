<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
    </testsuites>
    <source>
        <include><directory>app</directory></include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:dGVzdC1rZXktZm9yLXBocHVuaXQtb25seS0zMmJ5dGVz"/>
        <env name="APP_DEBUG" value="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="LUVUPAY_PAYMENT_DRIVER" value="mock"/>
        <env name="AUDIT_HMAC_KEY" value="phpunit-audit-key-not-secret"/>
        <env name="LUVUPAY_ALLOW_INSECURE_WEBHOOK_TARGETS" value="true"/>
        <env name="PAYPAL_MODE" value="sandbox"/>
    </php>
</phpunit>
