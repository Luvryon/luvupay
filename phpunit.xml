<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="LUVUPAY_REQUIRE_MFA" value="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <!-- Dedicated PostgreSQL test database. force="true" so .env (e.g. a Neon DB_URL) can never leak in.
             Create it once:  CREATE USER luvu WITH PASSWORD 'luvu';  CREATE DATABASE luvupay_test OWNER luvu; -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DATABASE_URL" value="" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="luvupay_test" force="true"/>
        <env name="DB_USERNAME" value="luvu" force="true"/>
        <env name="DB_PASSWORD" value="luvu" force="true"/>
        <env name="DB_SSLMODE" value="disable" force="true"/>
        <env name="DB_ENDPOINT" value="" force="true"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- The suite must never see real credentials from .env: with them present the marketplace tests would call
             the real PayPal Sandbox (mockPayments() is only true when the keys are empty). Tests set what they need via config(). -->
        <env name="LUVUPAY_PAYMENT_DRIVER" value="mock" force="true"/>
        <env name="PAYPAL_MODE" value="sandbox" force="true"/>
        <env name="PAYPAL_CLIENT_ID" value="" force="true"/>
        <env name="PAYPAL_SANDBOX_CLIENT_ID" value="" force="true"/>
        <env name="PAYPAL_LIVE_CLIENT_ID" value="" force="true"/>
        <env name="PAYPAL_SECRET" value="" force="true"/>
        <env name="PAYPAL_SANDBOX_SECRET" value="" force="true"/>
        <env name="PAYPAL_LIVE_SECRET" value="" force="true"/>
        <env name="PAYPAL_WEBHOOK_ID" value="" force="true"/>
        <env name="PAYPAL_PLAN_ID" value="" force="true"/>
        <env name="PAYPAL_SANDBOX_BUSINESS_EMAIL" value="" force="true"/>
        <env name="PAYPAL_SANDBOX_BUSINESS_PASSWORD" value="" force="true"/>
        <env name="PAYPAL_SANDBOX_BUYER_EMAIL" value="" force="true"/>
        <env name="PAYPAL_SANDBOX_BUYER_PASSWORD" value="" force="true"/>
        <env name="PAYPAL_MERCHANT_SANDBOX_EMAIL" value="" force="true"/>
        <env name="PAYPAL_CHARITY_SANDBOX_EMAIL" value="" force="true"/>
        <env name="NEBIUS_API_KEY" value="" force="true"/>
        <env name="LUVUPAY_DEMO_SIMULATOR" value="true"/>
    </php>
</phpunit>
